# Backend API URL (optional, defaults to http://localhost:8000/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public production origin. Use the final HTTPS domain without a trailing slash.
NEXT_PUBLIC_SITE_URL=https://scienceknowledgehub.com

# Optional public editorial email shown on the Contact and Privacy pages.
NEXT_PUBLIC_CONTACT_EMAIL=

# Add only after AdSense provides the values. Keep both blank before approval.
NEXT_PUBLIC_GOOGLE_ADSENSE_ACCOUNT=
GOOGLE_ADSENSE_PUBLISHER_ID=
