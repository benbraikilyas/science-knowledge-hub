# Crawl4AI is installed separately in the Python environment used to run this engine.
RESEARCH_MIN_VALID_SOURCES=3
RESEARCH_MIN_REVIEW_SCORE=85
RESEARCH_MAX_SOURCE_CHARS=30000
RESEARCH_RESPECT_ROBOTS=true
RESEARCH_AUTHOR_ID=sciencehub-editorial-team
RESEARCH_AUTHOR_NAME=ScienceHub Editorial Team

# Optional provider-compatible AI generation. Keep disabled for offline evidence scaffolds.
# Do not commit a real API key.
RESEARCH_LLM_ENABLED=false
RESEARCH_LLM_BASE_URL=https://your-provider.example/v1
RESEARCH_LLM_API_KEY=
RESEARCH_LLM_MODEL=
RESEARCH_LLM_TIMEOUT_SECONDS=60
RESEARCH_LLM_MAX_INPUT_CHARS=24000
